# LOCAL DEVELOPMENT DEFAULTS — the STAGING Supabase project, never
# production. Copy to .env.local (gitignored) and fill in from the web
# repo's own .env.staging, or the Supabase dashboard for project
# vdxdmtsnptzodabaojlc (Project Settings -> API).
#
# Both values are client-safe by design — the publishable/anon key is
# meant to ship inside the app binary; RLS is the actual security
# boundary. See README "Environments" for the full picture.
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
# Either key format works: sb_publishable_... (current) or the legacy anon JWT.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Next.js API base for the four /api/mobile/* calls (PayMongo checkout,
# cancel, reschedule, account deletion).
#
# This MUST target the same Supabase project as EXPO_PUBLIC_SUPABASE_URL
# above — a Supabase access token is only valid against the project that
# issued it, so a staging token sent to https://air-rally.com 401s every
# time. Locally that means the web repo's dev server:
#   cd "/Users/leou/AIR:Rally" && npm run dev
EXPO_PUBLIC_API_URL=http://localhost:3000
