# Same Supabase project as the AIR/Rally web app (air-rally.com). Both
# values are client-safe by design — the anon/publishable key is meant to
# ship inside the app binary; RLS is the actual security boundary.
# Copy to .env.local (gitignored) and fill in from the Supabase dashboard,
# Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either key format works: sb_publishable_... (current) or the legacy anon JWT.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Next.js API base for PayMongo checkout-session creation (the one web call the app makes).
# Local development: http://localhost:3000 with the web repo's dev server running.
EXPO_PUBLIC_API_URL=https://air-rally.com
