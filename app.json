{
  "expo": {
    "name": "AIR/Rally",
    "slug": "air-rally",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "airrally",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.airrally.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.airrally.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1e8",
          "image": "./assets/images/mark.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0b1d36",
            "image": "./assets/images/mark.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "AIR/Rally uses your photo library to set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c802dbac-e219-48e5-8216-0f64bd45f8fe"
      }
    },
    "owner": "galileouuu",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c802dbac-e219-48e5-8216-0f64bd45f8fe"
    }
  }
}
